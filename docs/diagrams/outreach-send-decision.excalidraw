{"id":"ev_code","type":"text","x":1198,"y":268,"width":390,"height":200,"text":"{\n  \"timezone\": \"Europe/London\",\n  \"start_hour\": 9, \"end_hour\": 17,\n  \"active_days\": [1, 2, 3, 4, 5],\n  \"email_per_day\": 15,\n  \"linkedin_invites_per_day\": 8,\n  \"linkedin_messages_per_day\": 15,\n  \"stop_on\": [\"replied\", \"bounced\",\n            \"meeting_booked\"]\n}","originalText":"{\n  \"timezone\": \"Europe/London\",\n  \"start_hour\": 9, \"end_hour\": 17,\n  \"active_days\": [1, 2, 3, 4, 5],\n  \"email_per_day\": 15,\n  \"linkedin_invites_per_day\": 8,\n  \"linkedin_messages_per_day\": 15,\n  \"stop_on\": [\"replied\", \"bounced\",\n            \"meeting_booked\"]\n}","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","containerId":null,"lineHeight":1.25},
