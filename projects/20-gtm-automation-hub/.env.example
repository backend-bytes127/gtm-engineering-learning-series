# Copy to .env (git-ignored) and fill in with your own editor. Never paste these values into chat, n8n or a commit.

# Any long random string, for example from: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Shared with whatever sends signals and PQL events to this hub. At least 16 characters.
GTM_HUB_WEBHOOK_SECRET=

# Slack app > Basic Information > App Credentials > Signing Secret. Only needed for button clicks.
SLACK_SIGNING_SECRET=
# Slack app > Incoming Webhooks. Leave commented to keep using the local fake endpoint.
# GTM_HUB_SLACK_WEBHOOK_URL=

# Optional: comma-separated Slack member IDs allowed to approve or dismiss. Empty means anyone in the channel.
SLACK_APPROVER_IDS=
